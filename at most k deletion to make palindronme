class Solution {
public:
    vector<vector<int>> memo;
    string s;

    int f(int i, int j) {
        if (i >= j) return 0;
        if (memo[i][j] != -1) return memo[i][j];

        if (s[i] == s[j])
            return memo[i][j] = f(i + 1, j - 1);

        return memo[i][j] = 1 + min(f(i + 1, j), f(i, j - 1));
    }

    bool isValidPalindrome(string str, int k) {
        s = str;
        int n = s.size();
        memo.assign(n, vector<int>(n, -1));
        return f(0, n - 1) <= k;
    }
};
