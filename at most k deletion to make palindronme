class Solution {
public:
    bool isValidPalindrome(string s, int k) {
        int n = s.size();
        vector<vector<int>> dp(n, vector<int>(n, 0));

        for (int i = n - 1; i >= 0; i--) {
            dp[i][i] = 1;
            for (int j = i + 1; j < n; j++) {
                if (s[i] == s[j])
                    dp[i][j] = 2 + dp[i + 1][j - 1];
                else
                    dp[i][j] = max(dp[i + 1][j], dp[i][j - 1]);
            }
        }
        return n - dp[0][n - 1] <= k;
    }
};
O(n) space (1D)
cpp
class Solution {
public:
    bool isValidPalindrome(string s, int k) {
        int n = s.size();
        vector<int> dp(n, 0);

        for (int i = n - 2; i >= 0; i--) {
            int prev = 0;                    // dp[i+1][j-1]
            for (int j = i + 1; j < n; j++) {
                int temp = dp[j];            // dp[i+1][j]
                if (s[i] == s[j])
                    dp[j] = prev;
                else
                    dp[j] = 1 + min(dp[j], dp[j - 1]);
                prev = temp;
            }
        }
        return dp[n - 1] <= k;
    }
};
