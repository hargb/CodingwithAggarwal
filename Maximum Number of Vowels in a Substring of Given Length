3. OPTIMAL CODE (Sliding Window)
int maxVowels(string s, int k) {
    int n = s.length();
    int count = 0;

    // first window
    for (int i = 0; i < k; i++) {
        if (s[i]=='a'||s[i]=='e'||s[i]=='i'||s[i]=='o'||s[i]=='u')
            count++;
    }

    int ans = count;

    // slide window
    for (int i = k; i < n; i++) {

        // add new character
        if (s[i]=='a'||s[i]=='e'||s[i]=='i'||s[i]=='o'||s[i]=='u')
            count++;

        // remove old character
        if (s[i-k]=='a'||s[i-k]=='e'||s[i-k]=='i'||s[i-k]=='o'||s[i-k]=='u')
            count--;

        ans = max(ans, count);
    }

    return ans;
}
