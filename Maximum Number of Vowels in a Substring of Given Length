int maxVowels(string s, int k) {
    int n = s.length();
    int maxCount = 0;

    for (int i = 0; i <= n - k; i++) {
        int count = 0;

        // check substring from i to i+k-1
        for (int j = i; j < i + k; j++) {
            if (s[j] == 'a' || s[j] == 'e' || 
                s[j] == 'i' || s[j] == 'o' || 
                s[j] == 'u') {
                count++;
            }
        }

        maxCount = max(maxCount, count);
    }

    return maxCount;
}


